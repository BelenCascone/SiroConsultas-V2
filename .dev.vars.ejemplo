# Copiá este archivo como .dev.vars (que NO se sube al repo) y completá los valores.
# Para generar valores al azar: openssl rand -hex 32
SESION_SECRETO=
TOTP_CLAVE=
CLAVE_PRUEBA=
# GOOGLE_CLIENT_ID=   (opcional en la compu; sin él se entra solo con la clave de prueba)
# Correo saliente (opcional). Sin SMTP_HOST, la demo simula los envíos y no sale nada.
# Puerto 587 usa STARTTLS; 465, TLS directo. Nunca se manda sin cifrar.
# SMTP_HOST=
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_REMITENTE=   (la dirección que aparece como remitente; si falta, se usa SMTP_USUARIO)
